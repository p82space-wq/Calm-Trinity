# Stripe API キー（Stripe Dashboard → 開発者 → API キー から取得）
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# サイト URL（本番: https://calm-trinity.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# お問い合わせ先メール（表示用）
NEXT_PUBLIC_CONTACT_EMAIL=calamtrinity82@gmail.com

# Instagram（未設定時はアイコンのみ表示）
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your_account/

# お問い合わせフォーム（Web3Forms — 無料）
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Webhook（ローカル: stripe listen --forward-to localhost:3000/api/webhooks/stripe）
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Stripe 連携フロー ---
# 1. npm run seed:stripe     → Product + Price 作成（POST /v1/products）
# 2. カート → Checkout      → Checkout Session 作成（POST /v1/checkout/sessions）
# 3. stripe listen           → checkout.session.completed を受信

# --- Vercel デプロイ ---
# 上記の環境変数を Production / Preview に登録し、
# NEXT_PUBLIC_SITE_URL を本番ドメインに設定してください。
